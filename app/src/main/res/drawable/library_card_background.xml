<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/roman_surface_pressed" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/roman_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/roman_surface_elevated" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/roman_outline" />
        </shape>
    </item>
</selector>
