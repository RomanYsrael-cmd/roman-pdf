<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_page_background"
    android:fitsSystemWindows="false">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/page_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/reader_page_background"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <ProgressBar
        android:id="@+id/reader_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/reader_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@drawable/reader_toolbar_background"
        android:elevation="3dp"
        android:minHeight="0dp"
        app:contentInsetStartWithNavigation="0dp" />

    <LinearLayout
        android:id="@+id/reader_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/reader_tool_tray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/reader_controls_background"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/mode_chip"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/reader_mode_chip_background"
                android:gravity="center_vertical"
                android:minWidth="118dp"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="10dp">

                <ImageButton
                    android:id="@+id/mode_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/switch_to_edit"
                    android:padding="12dp"
                    android:src="@drawable/ic_view" />

                <TextView
                    android:id="@+id/mode_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="@string/read_mode"
                    android:textColor="@color/reader_chrome_ink"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/annotation_tools_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="@color/reader_chrome_divider" />

                <ImageButton
                    android:id="@+id/pen_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/pen"
                    android:padding="11dp"
                    android:src="@drawable/ic_pen" />

                <ImageButton
                    android:id="@+id/highlighter_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/highlighter"
                    android:padding="11dp"
                    android:src="@drawable/ic_highlighter" />

                <ImageButton
                    android:id="@+id/eraser_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/eraser"
                    android:padding="11dp"
                    android:src="@drawable/ic_eraser" />

                <ImageButton
                    android:id="@+id/undo_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/undo"
                    android:padding="11dp"
                    android:src="@drawable/ic_undo" />

                <ImageButton
                    android:id="@+id/redo_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/redo"
                    android:padding="11dp"
                    android:src="@drawable/ic_redo" />

                <ImageButton
                    android:id="@+id/note_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/add_note"
                    android:padding="11dp"
                    android:src="@drawable/ic_note" />

                <ImageButton
                    android:id="@+id/color_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/annotation_color_default"
                    android:padding="11dp"
                    android:src="@drawable/ic_color" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
