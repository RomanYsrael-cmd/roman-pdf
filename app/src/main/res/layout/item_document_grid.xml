<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@color/roman_surface"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/document_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@color/roman_thumbnail_placeholder"
        android:contentDescription="@string/page"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/document_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/roman_on_surface"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/document_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/roman_on_surface_variant"
        android:textSize="12sp" />
</LinearLayout>
